class Entry {

	void* entryObject;
	std::fs::Type* fileSystem;
	std::ds::SLList list;
	
	/* Public data members */
	void(std::ApplicationInstance,
		std::fs::Entry*,
		unsigned int) callback;
	unsigned int cursor;
	unsigned char mode;
	void* parameters;
	std::str::DString path;
	unsigned char state;

	Entry(){
		cursor = 0;
		entryObject = nullptr;
		fileSystem = nullptr;
		mode = 0;
		state = 0;
	}
	
	unsigned int findFileSystem(){
		return path.find("://", 0, 3, 0, nullptr);
	}
	
	static std::ds::SLList* getList(void* entry){
		return &((std::fs::Entry*)entry->list);
	}
	
	bool pushTofileSystemQueue(
		std::ApplicationInstance aexcl app,
		unsigned char entryState){
		if (state == std::fs::EntryStates::open){
			state = entryState;
			app.fileSystem.
				pushTofileSystemQueue(app, this);
			return true;
		}
		return false;
	}
	
	bool setFileSystem(std::ds::PtrArray* types){
		unsigned int i = findFileSystem();
		if (i > 1){
			std::str::View string;
			string.set(path.data, 0, i - 1);
			i = types->findSorted(
				&string, std::fs::Type::cmpString);
			if (i != 0){
				fileSystem = (std::fs::Type*)
					(types->data[i - 1]);
				return true;
			}
		}
		fileSystem = nullptr;
		return false;
	}
	
