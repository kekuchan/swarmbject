	/* Public member functions */
	
	bool close(
		std::ApplicationInstance aexcl app){
		return pushTofileSystemQueue(app,
			std::fs::EntryStates::close);
	}
	
	void firstPathEntry(
		std::str::View* entry){
		unsigned int i = findFileSystem();
		if (i != 0){
			entry->set(path.data, 0, i + 2);
			nextPathEntry(entry);
		} else {
			entry->set(path.data, 0, 0);
		}
	}
	
	unsigned int info(unsigned char mode, 
		unsigned char[] str, unsigned int i){
		unsigned int j;
		if (state == std::fs::EntryStates::open){
			j = fileSystem->info(this, str, i, mode);
		} else {
			j = 0;
		}
		return j;
	}
	
	void infoDString(unsigned char mode, 
		std::str::DString* string){
		unsigned int start = string->length;
		info(mode, string->grow(
			info(mode, nullptr, 0)), start);
	}
	
	bool isAppend(){
		switch (mode){
			case std::fs::FileModes::append:
			case std::fs::FileModes::appendUpdate:
				return true;
		}
		return false;
	}
	
	bool isFile(){
		return isFilePath(&path);
	}
	
	static bool isFilePath(
		std::str::DString* path){
		return path->length >= 4 &&
			path->data[path->length - 1] != '/';
	}
	
	bool isFolder(){
		return isFolderPath(&path);
	}
	
	static bool isFolderPath(
		std::str::DString* path){
		return path->length >= 3 &&
			path->data[path->length - 1] == '/';
	}
	
	void nextPathEntry(
		std::str::View* entry){
		unsigned int i = entry->start + 
			entry->length + 1;
		unsigned char[] data = path.data;
		unsigned int len = path.length;
		while (true){
			if (i < len){
				if (data[i] != '/'){
					unsigned int start = i;
					while (true){
						i = i + 1;
						if (i == len || data[i] == '/'){
							entry->set(data, start, i - start);
							break;
						}
					}
					break;
				}
			} else {
				entry->set(data, len, 0);
				break;
			}
			i = i + 1;
		}
	}
	
	bool open(
		std::ApplicationInstance aexcl app){
		std::fs::FileSystem* fileSystem =
			&app.fileSystem;
		if (state == std::fs::EntryStates::none &&
			setFileSystem(&fileSystem->types)){
			state = std::fs::EntryStates::opening;
			fileSystem->pushTofileSystemQueue(
				app, this);
			return true;
		}
		return false;
	}
	
	bool read(
		std::ApplicationInstance aexcl app){
		return pushTofileSystemQueue(app,
			std::fs::FileStates::read);
	}
	
	bool readCall(
		std::ApplicationInstance aexcl app){
		return pushTofileSystemQueue(app,
			std::fs::FileStates::readCall);
	}
	
	void set(unsigned char[] str,
		unsigned int i, unsigned int max,
		unsigned char mode,
		void(std::ApplicationInstance, 
			std::fs::Entry*,
			unsigned int) callback,
		unsigned int seek,
		void* parameters){
		if (state == std::fs::EntryStates::none){
			this->path.set(str, i, max);
			this->mode = mode;
			this->callback = callback;
			cursor = seek;
			this->parameters = parameters;
		}
	}
	
	bool write(
		std::ApplicationInstance aexcl app){
		return pushTofileSystemQueue(app,
			std::fs::FileStates::write);
	}
	
	bool writeCall(
		std::ApplicationInstance aexcl app){
		return pushTofileSystemQueue(app,
			std::fs::FileStates::writeCall);
	}
	
	bool writeMove(
		std::ApplicationInstance aexcl app){
		return pushTofileSystemQueue(app,
			std::fs::FileStates::writeMove);
	}
	
